{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commands": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "constraints": {
      "additionalProperties": false,
      "properties": {
        "destructive_commands": {
          "default": "deny",
          "minLength": 1,
          "type": "string"
        },
        "network": {
          "default": "approval_required",
          "minLength": 1,
          "type": "string"
        },
        "secrets_policy": {
          "default": "never_read_env_files",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "network",
        "secrets_policy",
        "destructive_commands"
      ],
      "type": "object"
    },
    "cwd": {
      "description": "Absolute path to the target repository.",
      "minLength": 1,
      "type": "string"
    },
    "executor": {
      "additionalProperties": false,
      "properties": {
        "default_cli": {
          "enum": [
            "claude",
            "codex",
            "glm"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "id": {
      "description": "Repository environment profile identifier.",
      "minLength": 1,
      "type": "string"
    },
    "pr": {
      "additionalProperties": false,
      "default": {
        "base": "main",
        "comments": {
          "enabled": true,
          "reply": true
        },
        "enabled": true
      },
      "properties": {
        "base": {
          "default": "main",
          "type": "string"
        },
        "comments": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "reply": {
              "default": true,
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "required_checks": {
      "additionalProperties": false,
      "properties": {
        "shell": {
          "enum": [
            "auto",
            "sh",
            "bash",
            "cmd",
            "powershell",
            "pwsh"
          ],
          "type": "string"
        },
        "shell_path": {
          "description": "Explicit executable path override for required-check shell selection. When the basename is one of `bash`, `sh`, `cmd.exe`, `powershell.exe`, or `pwsh.exe` (case-insensitive, optional `.exe`, either `/` or `\\` separators), `shell_path` may stand alone and Galley infers the invocation style from the executable name. When both `shell` and `shell_path` are set, `shell_path` takes precedence as the more specific executable selection and Galley will not invoke that executable using an incompatible style from `shell`. When the basename is not recognized, an explicit `required_checks.shell` kind is required as fallback metadata. In Windows YAML, escape backslashes only in double-quoted strings; single-quoted or plain scalars use single backslashes. Leading and trailing whitespace is invalid.",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "setup": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "run": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "why": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "run"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "commands"
      ],
      "type": "object"
    },
    "supervisor": {
      "additionalProperties": false,
      "properties": {
        "default_cli": {
          "enum": [
            "claude",
            "codex",
            "glm"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "worktree": {
      "additionalProperties": false,
      "default": {
        "cleanup": true
      },
      "properties": {
        "cleanup": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "id",
    "cwd",
    "constraints"
  ],
  "title": "Galley Environment Profile YAML",
  "type": "object"
}
